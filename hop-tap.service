[Unit]
Description=hop-tap eBPF terminal capture daemon
Documentation=https://wirehop.org/tap
# Start after hop so the manifest is in place before we open the
# bootstrap rendezvous; if hop comes back later (restart, upgrade)
# we'll be re-read on its next start.
After=hop.service network.target
Wants=hop.service

[Service]
Type=simple
# eBPF needs CAP_BPF / CAP_PERFMON / CAP_SYS_ADMIN. Easiest correct
# path is just root; the daemon's threat model already assumes it
# (it reads every byte of every TTY on the host).
User=root
ExecStart=/usr/local/bin/hop-tap-d --bootstrap /run/hop-tap/bootstrap

# Auto-create /run/hop-tap with 0755 root:root. The directory has to
# be traversable by non-root users so they can reach the standalone
# `tap` CLI's local socket (/run/hop-tap/local.sock, mode 0666 with
# SO_PEERCRED authentication). The bootstrap file inside stays 0600
# root-only; directory listing is non-sensitive (just two entry names).
RuntimeDirectory=hop-tap
RuntimeDirectoryMode=0755

# If we crash, restart — capture is "should always be on."
Restart=on-failure
RestartSec=5

# Reasonable hardening. We deliberately do NOT set NoNewPrivileges
# (BPF program load can interact with capability checks in surprising
# ways) and we keep network access (the daemon doesn't need it
# directly, but ipc-channel + future hop bootstrap may).
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
# /run/hop-tap is created by RuntimeDirectory= above; it always
# exists when this unit starts. /etc/hop is owned by hop and may
# not exist on a standalone tap install — the leading `-` tells
# systemd to ignore it if missing instead of failing namespace
# setup with status=226/NAMESPACE.
ReadWritePaths=/run/hop-tap -/etc/hop

[Install]
WantedBy=multi-user.target
