[36.383, "o", "\u001b[2J\u001b[H\u001b[1m\u250c\u2500\u2500 tap \u2014 terminal session picker \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[0m\r\n\u001b[1m\u2502\u001b[0m pty   user                comm        age      idle                         \u001b[1m\u2502\u001b[0m\r\n\u001b[1m\u2502\u001b[0m    3   alice(1000)        bash        82s      0ms                         \u001b[1m\u2502\u001b[0m\r\n\u001b[1m\u2502\u001b[0m \u001b[7m\ud83c\udfad  4   \u001b[31mroot(0)\u001b[0m             bash        45s      0ms                       \u001b[0m\u001b[1m\u2502\u001b[0m\r\n\u001b[1m\u2502\u001b[0m                                                                              \u001b[1m\u2502\u001b[0m\r\n\u001b[1m\u2502\u001b[0m  \u001b[2mpreview of pty 4 (root) \u2500\u2500 live\u001b[0m                                            \u001b[1m\u2502\u001b[0m\r\n\u001b[1m\u2502\u001b[0m  \u001b[31mroot@web-prod\u001b[0m:~# id                                              \u001b[1m\u2502\u001b[0m\r\n\u001b[1m\u2502\u001b[0m  uid=0(root) gid=0(root) groups=0(root)                                    \u001b[1m\u2502\u001b[0m\r\n\u001b[1m\u2502\u001b[0m  \u001b[31mroot@web-prod\u001b[0m:~#                                                 \u001b[1m\u2502\u001b[0m\r\n\u001b[1m\u2502\u001b[0m  \u001b[7m\u001b[33m  admin: alice  \u001b[0m                                             \u001b[1m\u2502\u001b[0m\r\n\u001b[1m\u2502\u001b[0m  \u001b[33m  what are you doing on this machine?\u001b[0m                            \u001b[1m\u2502\u001b[0m\r\n\u001b[1m\u2502\u001b[0m  \u001b[31mroot@web-prod\u001b[0m:~# i was just looking around, im sorry             \u001b[1m\u2502\u001b[0m\r\n\u001b[1m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u250