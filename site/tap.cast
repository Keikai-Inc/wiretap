[3.049931, "o", "\r\n"]
[3.057651, "o", "\u001b[0;33mwarn\u001b[0m  hop is installed but the daemon isn't running.\r\n"]
[3.05776, "o", "\u001b[0;33mwarn\u001b[0m  Installing hop-tap in standalone mode. Start hop and re-run this\r\n\u001b[0;33mwarn\u001b[0m  installer to register hop-tap with the hop network.\r\n"]
