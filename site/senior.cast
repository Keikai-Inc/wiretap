[11.55, "o", "\u001b[2m[tap connect pty=7 bob@web-prod \u2014 Ctrl-T detach  Ctrl-G message]\u001b[0m\r\n\u001b[1m\u001b[33mbob@web-prod\u001b[0m:\u001b[1m\u001b[34m~\u001b[0m$ sudo systemctl reload nginx\r\nJob for nginx.service failed (control process exit code).\r\nSee: journalctl -xeu nginx.service\r\n\u001b[1m\u001b[33mbob@web-prod\u001b[0m:\u001b[1m\u001b[34m~\u001b[0m$ sudo systemctl status nginx\r\n\u001b[31m\u00d7\u001b[0m nginx.service - A high performance web server\r\n     Active: \u001b[31mfailed\u001b[0m (Result: exit-code)\r\n   Main PID: 4421 (code=exited, status=1/FAILURE)\r\n\u001b[1m\u001b[33mbob@web-prod\u001b[0m:\u001b[1m\u001b[34m~\u001b[0m$ sudo journalctl -u nginx -n 3 --no-pager\r\nApr 30 14:22:11 systemd[1]: Reloading nginx.service...\r\nApr 30 14:22:11 nginx[4421]: nginx: [\u001b[31memerg\u001b[0m] invalid value \"foo\" in site.conf:42\r\nApr 30 14:22:11 systemd[1]: Reload failed for nginx.service.\r\n\u001b[1m\u001b[33mbob@web-prod\u001b[0m:\u001b[1m\u001b[34m~\u001b[0m$ "]
