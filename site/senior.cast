[9.55, "o", "\u001b[2m[tap connect pty=7 bob@web-prod \u2014 Ctrl-T detach  Ctrl-G message]\u001b[0m\r\n\u001b[1m\u001b[33mbob@web-prod\u001b[0m:\u001b[1m\u001b[34m~\u001b[0m$ sudo systemctl reload nginx\r\nJob for nginx.service failed because the control process exited with error code.\r\nSee \"systemctl status nginx.service\" and \"journalctl -xeu nginx.service\" for details.\r\n\u001b[1m\u001b[33mbob@web-prod\u001b[0m:\u001b[1m\u001b[34m~\u001b[0m$ sudo journalctl -u nginx -n 5 --no-pager\r\nApr 30 14:22:11 web-prod systemd[1]: Reloading nginx.service...\r\nApr 30 14:22:11 web-prod nginx[4421]: nginx: the configuration file /etc/nginx/nginx.conf syntax is\r\nApr 30 14:22:11 web-prod nginx[4421]: nginx: [emerg] invalid value \"foo\" in /etc/nginx/conf.d/site.conf:42\r\nApr 30 14:22:11 web-prod systemd[1]: nginx.service: Control process exited, code=exited, status=1\r\nApr 30 14:22:11 web-prod systemd[1]: Reload failed for nginx.service.\r\n\u001b[1m\u001b[33mbob@web-prod\u001b[0m:\u001b[1m\u001b[34m~\u001b[0m$ "]
